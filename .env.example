NEXT_PUBLIC_SITE_URL=https://appliancekingrepair.com
# Google tag (defaults to AW-18128296932 in lib/business.ts)
NEXT_PUBLIC_GOOGLE_TAG_ID=AW-18128296932
# Optional GA4 measurement ID, added to the same Google tag
NEXT_PUBLIC_GA_ID=
# Meta pixel / dataset (defaults to the Appliance King dataset)
NEXT_PUBLIC_META_PIXEL_ID=4472553883061795
# Microsoft Advertising UET tag ID (Microsoft Ads > Conversions > UET tag)
NEXT_PUBLIC_UET_TAG_ID=
# Optional Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=
# Google Ads conversion labels (Google Ads > Goals > Conversions > Tag setup), the part after AW-18128296932/
NEXT_PUBLIC_GADS_BOOKING_LABEL=
NEXT_PUBLIC_GADS_SHOP_LABEL=
NEXT_PUBLIC_GADS_ESTIMATE_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=hTi1CLihlp0dEOS3n8RD
# Meta Conversions API (server). Events Manager > Dataset > Settings > Conversions API > Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager > Test events code (remove after testing)
META_TEST_EVENT_CODE=
